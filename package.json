{
  "name": "e-commerce",
  "version": "1.0.0",
  "type": "module",
  "description": "building an e-commerce website",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon --exec tsx server.js",
    "start": "tsx server.js",
    "seed": "tsx prisma/seed.js",
    "pretest": "node scripts/prismaTestReset.js",
    "test": "set NODE_ENV=test && set DOTENV_CONFIG_PATH=.env.test && vitest run",
    "test:watch": "set NODE_ENV=test && set DOTENV_CONFIG_PATH=.env.test && vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross": "^1.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-rate-limiter": "^1.3.1",
    "express-xss-sanitizer": "^2.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammdHassanSawaha/e-commerce.git"
  },
  "author": "Mohammad Hassan Sawaha",
